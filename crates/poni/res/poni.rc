// Task Manager and Settings > Apps > Startup name the app by FileDescription and its publisher by CompanyName,
// so both say ihz.land. LegalCopyright keeps the holder that LICENSE names.
1 ICON "poni.ico"
1 24 "poni.manifest"

1 VERSIONINFO
FILEVERSION 0,2,33,0
PRODUCTVERSION 0,2,33,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "ihz.land\0"
      VALUE "FileDescription", "ihz.land\0"
      VALUE "FileVersion", "0.2.33\0"
      VALUE "InternalName", "poni\0"
      VALUE "LegalCopyright", "Copyright (C) 2026 Jatevo Labs\0"
      VALUE "OriginalFilename", "poni.exe\0"
      VALUE "ProductName", "ihz.land\0"
      VALUE "ProductVersion", "0.2.33\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
